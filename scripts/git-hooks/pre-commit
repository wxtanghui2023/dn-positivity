#!/usr/bin/env bash
# dn-project pre-commit 机械闸门（唐先生 16:02 / 17:47）
#  规则1：docs/ 下【新增】.md 必须带「已查地图：」标记
#  规则2（NEWNESS RULE）：新档若宣称"新"，必须附【技术词回查】输出（技术词…命中文件数=）
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

bad=""
newness_bad=""
for f in $(git diff --cached --name-only --diff-filter=A | grep -a '^docs/.*\.md$' || true); do
  case "$f" in *ERRATUM*) continue;; esac
  # 外部复核件豁免（唐先生 17:53 建议的"剥叙事"件：按设计【不得】带内部编号/标记）
  if head -20 "$f" 2>/dev/null | grep -aq "外部复核件"; then continue; fi
  # 规则1
  if ! head -20 "$f" 2>/dev/null | grep -aq "已查地图"; then bad="$bad $f"; fi
  # 规则2
  if grep -aq -E "不重复|新手段|新用途|从未触及|首次|新发现" "$f" 2>/dev/null; then
    if ! grep -aq -E "技术词.*命中文件数=" "$f" 2>/dev/null; then newness_bad="$newness_bad $f"; fi
  fi
done

rc=0
if [ -n "$bad" ]; then
  echo "⛔ 拒绝：以下新增 docs 档缺「已查地图：」标记："
  for f in $bad; do echo "   - $f"; done
  echo "   先跑： scripts/prework_map_check.sh <关键词...>  然后把结论行粘到档首"
  rc=1
fi
if [ -n "$newness_bad" ]; then
  echo "⛔ 拒绝（NEWNESS RULE）：以下新档宣称『新』但缺【技术词回查】输出："
  for f in $newness_bad; do echo "   - $f"; done
  echo "   请先跑： scripts/tech_word_check.sh <技术词...>  并把结果粘进档内"
  echo "   依据： docs/ERRATUM-T10-ATTACK-S1-and-W1-corrections-archive-already-had-it.md §5"
  rc=1
fi
exit $rc
